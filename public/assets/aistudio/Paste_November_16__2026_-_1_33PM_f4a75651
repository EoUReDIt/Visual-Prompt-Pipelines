  <script>
    const uid = () => Math.random().toString(36).slice(2, 9);

    const BLOCK_TYPES = [
      "Overarching Request",
      "Model & Task",
      "Concept & Scene",
      "Subject Details",
      "Reference Photos",
      "Constraints",
