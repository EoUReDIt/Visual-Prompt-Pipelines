              { id: uid(), kind: "text", name: "Continuity Errors", content: "Flag any wardrobe, lighting, or prop mismatches between cuts." }
            ]
          },
          {
            id: uid(), title: "Constraints", type: "Constraints", expanded: false,
            fields: [
              { id: uid(), kind: "positive", name: "Output Structure", content: "List findings with exact timestamps and actionable fixes." },
              { id: uid(), kind: "negative", name: "Exclude", content: "Do not summarize plot; focus strictly on visual/editorial critique." }
            ]
          }
        ]
      },
      "visual-study": {
        label: "Visual Analyst (Two-Item Study)",
        title: "Visual Analyst — Two-Item Study",
        blocks: [
          {
            id: uid(), title: "Overarching Request", type: "Overarching Request", expanded: true,
            fields: [
              { id: uid(), kind: "text", name: "Study Objective", content: "Compare Item A and Item B side-by-side for material quality and design consistency." }
            ]
          },
          {
            id: uid(), title: "Items to Study", type: "Reference Photos", expanded: true,
            fields: [
