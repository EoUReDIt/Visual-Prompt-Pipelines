            fields: [
              { id: uid(), kind: "positive", name: "Must Include", content: "Shallow depth of field, smooth camera push-in, crisp metallic reflections." },
              { id: uid(), kind: "negative", name: "Avoid", content: "No warped hands, no text overlays, no sudden jump cuts." }
            ]
          }
        ]
