              { id: uid(), kind: "image", name: "Item B (Reference Photo)", content: "Updated production sample.", imageName: "", imageUrl: "" }
            ]
          },
          {
            id: uid(), title: "Comparison Form", type: "Custom Section", expanded: true,
            fields: [
              { id: uid(), kind: "text", name: "Color & Finish", content: "Compare surface texture, sheen, and color accuracy." },
              { id: uid(), kind: "text", name: "Stitching / Proportions", content: "Identify any alignment or proportion drift." }
            ]
          },
          {
            id: uid(), title: "Constraints", type: "Constraints", expanded: false,
            fields: [
              { id: uid(), kind: "positive", name: "Report Style", content: "Present a clear comparison table followed by a pass/fail recommendation." },
              { id: uid(), kind: "negative", name: "Avoid", content: "Do not guess dimensions that are not visually verifiable." }
            ]
          }
        ]
      },
      "blank": {
        label: "Blank Pipeline",
        title: "Untitled Pipeline",
        blocks: [
          {
            id: uid(), title: "Overarching Request", type: "Overarching Request", expanded: true,
            fields: [{ id: uid(), kind: "text", name: "Request", content: "" }]
          }
        ]
      }
    };

    function loadCustomTemplates() {
      try {
        return JSON.parse(localStorage.getItem("vp_custom_templates") || "{}");
      } catch {
        return {};
      }
    }

    function getAllTemplates() {
      return { ...DEFAULT_TEMPLATES, ...loadCustomTemplates() };
    }

    function cloneTemplate(tpl) {
      return {
        title: tpl.title,
        blocks: tpl.blocks.map(b => ({
          ...b,
          id: uid(),
          fields: b.fields.map(f => ({ ...f, id: uid() }))
        }))
      };
    }

    let state = {
      templateKey: "video-gen",
      ...cloneTemplate(DEFAULT_TEMPLATES["video-gen"])
    };

    const esc = (str = "") =>
      String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");

    function renderTemplateSelect() {
      const sel = document.getElementById("templateSelect");
      const all = getAllTemplates();
      sel.innerHTML = Object.entries(all)
        .map(([k, v]) => `<option value="${esc(k)}" ${k === state.templateKey ? "selected" : ""}>${esc(v.label)}</option>`)
        .join("");
    }

    function renderMarkdown() {
      const lines = [];
      lines.push(`# ${state.title.trim() || "Pipeline"}`);
      lines.push("");

      state.blocks.forEach((block, idx) => {
        lines.push(`## ${idx + 1}. ${block.title.trim() || block.type}`);
        if (!block.fields.length) {
          lines.push(`*(No fields added)*`);
        } else {
          block.fields.forEach(f => {
            const label = f.name.trim() || "Field";
            const content = f.content.trim();
            if (f.kind === "positive") {
              lines.push(`- **[POSITIVE] ${label}:** ${content || "—"}`);
            } else if (f.kind === "negative") {
              lines.push(`- **[NEGATIVE] ${label}:** ${content || "—"}`);
            } else if (f.kind === "image") {
              const imgTag = f.imageName ? ` \`[${f.imageName}]\`` : " `[No image attached]`";
              lines.push(`- **[PHOTO REF] ${label}**${imgTag}: ${content || "—"}`);
            } else {
              if (content.includes("\n")) {
                lines.push(`- **${label}:**`);
                content.split("\n").forEach(line => lines.push(`  ${line}`));
              } else {
                lines.push(`- **${label}:** ${content || "—"}`);
              }
            }
          });
        }
        lines.push("");
      });

      document.getElementById("markdownPreview").textContent = lines.join("\n").trim();
    }

    function renderBlocks() {
      document.getElementById("pipelineTitle").value = state.title;
      const stack = document.getElementById("pipelineStack");
      stack.innerHTML = "";

      state.blocks.forEach((block, idx) => {
        if (idx > 0) {
          const conn = document.createElement("div");
          conn.className = "connector";
          conn.innerHTML = `<div class="connector-line"></div><div class="connector-arrow">▼</div>`;
          stack.appendChild(conn);
        }

        const card = document.createElement("div");
        card.className = `block ${block.expanded ? "expanded" : ""}`;

        const fieldsHtml = block.fields.map(f => `
          <div class="field-row" data-kind="${esc(f.kind)}">
            <div class="field-top">
              <select class="field-kind" data-action="change-kind" data-bid="${block.id}" data-fid="${f.id}">
                <option value="text" ${f.kind === "text" ? "selected" : ""}>Form Field</option>
                <option value="image" ${f.kind === "image" ? "selected" : ""}>Photo Ref</option>
                <option value="positive" ${f.kind === "positive" ? "selected" : ""}>+ Positive</option>
                <option value="negative" ${f.kind === "negative" ? "selected" : ""}>- Negative</option>
              </select>
              <input
                type="text"
                class="field-name"
                placeholder="Field name (e.g., Subject Outfit)"
                value="${esc(f.name)}"
                data-action="edit-field-name"
                data-bid="${block.id}"
                data-fid="${f.id}"
              />
              <button class="icon-btn danger" data-action="remove-field" data-bid="${block.id}" data-fid="${f.id}" title="Remove field">✕</button>
            </div>
            ${f.kind === "image" ? `
              <div class="image-row">
                <input type="file" accept="image/*" data-action="upload-image" data-bid="${block.id}" data-fid="${f.id}" />
                ${f.imageUrl ? `<img class="image-preview" src="${esc(f.imageUrl)}" alt="Preview" />` : ""}
                ${f.imageName ? `<span class="image-filename">${esc(f.imageName)}</span>` : ""}
              </div>
            ` : ""}
            <textarea
              class="field-content"
              placeholder="${f.kind === 'image' ? 'Describe how the model should use this photo (e.g., apply to subject, scene backdrop, or analysis-only)...' : 'Enter content for this field...'}"
              data-action="edit-field-content"
              data-bid="${block.id}"
              data-fid="${f.id}"
            >${esc(f.content)}</textarea>
          </div>
        `).join("");

        const typeOptions = BLOCK_TYPES.map(t =>
          `<option value="${esc(t)}" ${t === block.type ? "selected" : ""}>${esc(t)}</option>`
        ).join("");

        card.innerHTML = `
          <div class="block-head" data-action="toggle-block" data-bid="${block.id}">
            <div class="block-head-left">
              <span class="step-badge">${idx + 1}</span>
              <span class="block-title-display">${esc(block.title || block.type)}</span>
              <span class="block-meta">(${block.fields.length} ${block.fields.length === 1 ? "field" : "fields"})</span>
            </div>
            <div class="block-actions">
              <button class="icon-btn" data-action="move-up" data-bid="${block.id}" ${idx === 0 ? "disabled" : ""} title="Move Up">↑</button>
              <button class="icon-btn" data-action="move-down" data-bid="${block.id}" ${idx === state.blocks.length - 1 ? "disabled" : ""} title="Move Down">↓</button>
              <button class="icon-btn danger" data-action="remove-block" data-bid="${block.id}" title="Delete Block">✕</button>
              <span class="chevron">▼</span>
            </div>
          </div>
          <div class="block-body">
            <div class="block-settings">
              <label>
                Block Name
                <input type="text" value="${esc(block.title)}" data-action="edit-block-title" data-bid="${block.id}" />
              </label>
              <label>
                Swap Block Type
                <select data-action="swap-block-type" data-bid="${block.id}">${typeOptions}</select>
              </label>
            </div>
            <div class="fields-list">${fieldsHtml}</div>
            <div class="add-field-bar">
              <button data-action="add-field" data-kind="text" data-bid="${block.id}">+ Form Field</button>
              <button data-action="add-field" data-kind="image" data-bid="${block.id}">+ Photo Ref</button>
              <button data-action="add-field" data-kind="positive" data-bid="${block.id}">+ Positive Rule</button>
              <button data-action="add-field" data-kind="negative" data-bid="${block.id}">+ Negative Rule</button>
            </div>
          </div>
        `;
        stack.appendChild(card);
      });

      renderMarkdown();
    }

    function findBlock(bid) {
      return state.blocks.find(b => b.id === bid);
    }

    // Event delegation for smooth typing (only updates markdown on text input, no DOM wipe)
    document.getElementById("pipelineTitle").addEventListener("input", e => {
      state.title = e.target.value;
      renderMarkdown();
    });

    const stackEl = document.getElementById("pipelineStack");

    stackEl.addEventListener("input", e => {
      const { action, bid, fid } = e.target.dataset;
      if (!action) return;
      const block = findBlock(bid);
      if (!block) return;

      if (action === "edit-block-title") {
        block.title = e.target.value;
        const display = e.target.closest(".block").querySelector(".block-title-display");
        if (display) display.textContent = block.title || block.type;
        renderMarkdown();
      } else if (action === "edit-field-name") {
        const field = block.fields.find(f => f.id === fid);
        if (field) { field.name = e.target.value; renderMarkdown(); }
      } else if (action === "edit-field-content") {
        const field = block.fields.find(f => f.id === fid);
        if (field) { field.content = e.target.value; renderMarkdown(); }
      }
    });

    stackEl.addEventListener("change", e => {
      const { action, bid, fid } = e.target.dataset;
      if (!action) return;
      const block = findBlock(bid);
      if (!block) return;

      if (action === "swap-block-type") {
        block.type = e.target.value;
        if (BLOCK_TYPES.includes(block.title)) block.title = e.target.value;
        renderBlocks();
      } else if (action === "change-kind") {
        const field = block.fields.find(f => f.id === fid);
        if (field) { field.kind = e.target.value; renderBlocks(); }
      } else if (action === "upload-image") {
        const file = e.target.files[0];
        const field = block.fields.find(f => f.id === fid);
        if (file && field) {
          field.imageName = file.name;
          const reader = new FileReader();
          reader.onload = ev => {
            field.imageUrl = ev.target.result;
            renderBlocks();
          };
          reader.readAsDataURL(file);
        }
      }
    });

    stackEl.addEventListener("click", e => {
      const target = e.target.closest("[data-action]");
      if (!target) return;
      const { action, bid, fid, kind } = target.dataset;

      // Ignore clicks on buttons inside block-head when toggling collapse
      if (action === "toggle-block" && e.target.closest(".block-actions")) return;

      const idx = state.blocks.findIndex(b => b.id === bid);
      const block = state.blocks[idx];

      if (action === "toggle-block" && block) {
        block.expanded = !block.expanded;
        renderBlocks();
      } else if (action === "move-up" && idx > 0) {
        [state.blocks[idx - 1], state.blocks[idx]] = [state.blocks[idx], state.blocks[idx - 1]];
        renderBlocks();
      } else if (action === "move-down" && idx < state.blocks.length - 1) {
        [state.blocks[idx + 1], state.blocks[idx]] = [state.blocks[idx], state.blocks[idx + 1]];
        renderBlocks();
      } else if (action === "remove-block" && idx > -1) {
        state.blocks.splice(idx, 1);
        renderBlocks();
      } else if (action === "add-field" && block) {
        block.fields.push({
          id: uid(),
          kind: kind || "text",
          name: "",
          content: "",
          imageName: "",
          imageUrl: ""
        });
        renderBlocks();
      } else if (action === "remove-field" && block) {
        block.fields = block.fields.filter(f => f.id !== fid);
        renderBlocks();
      }
    });

    // Topbar actions
    document.getElementById("templateSelect").addEventListener("change", e => {
      const key = e.target.value;
      const all = getAllTemplates();
      if (all[key]) {
        state = { templateKey: key, ...cloneTemplate(all[key]) };
        renderBlocks();
      }
    });

    document.getElementById("saveTemplateBtn").addEventListener("click", () => {
      const name = prompt("Name this reusable template:", state.title || "My Pipeline");
      if (!name || !name.trim()) return;
      const key = "custom-" + uid();
      const custom = loadCustomTemplates();
      custom[key] = {
        label: "★ " + name.trim(),
        title: name.trim(),
        blocks: state.blocks.map(b => ({
          ...b,
          fields: b.fields.map(f => ({ ...f, imageUrl: "" })) // avoid blowing localStorage quota with base64 images
        }))
      };
      localStorage.setItem("vp_custom_templates", JSON.stringify(custom));
      state.templateKey = key;
      renderTemplateSelect();
      alert(`Saved "${name.trim()}" to the Template dropdown!`);
    });

    document.getElementById("expandAllBtn").addEventListener("click", () => {
      state.blocks.forEach(b => (b.expanded = true));
      renderBlocks();
    });

    document.getElementById("collapseAllBtn").addEventListener("click", () => {
      state.blocks.forEach(b => (b.expanded = false));
      renderBlocks();
    });

    document.getElementById("addBlockBtn").addEventListener("click", () => {
      state.blocks.push({
        id: uid(),
        title: "Custom Section",
        type: "Custom Section",
        expanded: true,
        fields: [{ id: uid(), kind: "text", name: "", content: "" }]
      });
      renderBlocks();
    });

    document.getElementById("copyMdBtn").addEventListener("click", async () => {
      const text = document.getElementById("markdownPreview").textContent;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById("copyMdBtn");
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = "Copy Markdown"), 1500);
    });

    document.getElementById("downloadMdBtn").addEventListener("click", () => {
      const text = document.getElementById("markdownPreview").textContent;
      const blob = new Blob([text], { type: "text/markdown" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = (state.title || "pipeline").toLowerCase().replace(/[^a-z0-9]+/g, "-") + ".md";
      a.click();
      URL.revokeObjectURL(url);
    });

    // Init
    renderTemplateSelect();
    renderBlocks();
  </script>
</body>
</html>
