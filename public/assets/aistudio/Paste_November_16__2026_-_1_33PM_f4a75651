              { id: uid(), kind: "image", name: "Scene Environment Ref", content: "Use this street setting and wet reflections as the backdrop.", imageName: "", imageUrl: "" },
              { id: uid(), kind: "image", name: "Analysis-Only Ref (Style)", content: "Analyze color grading and lighting contrast only — do not copy objects.", imageName: "", imageUrl: "" }
            ]
          },
          {
