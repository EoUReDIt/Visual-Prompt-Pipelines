        label: "Video Analyst Pipeline",
        title: "Video Analyst Pipeline",
        blocks: [
          {
            id: uid(), title: "Overarching Request", type: "Overarching Request", expanded: true,
            fields: [
              { id: uid(), kind: "text", name: "Analysis Goal", content: "Audit the uploaded video for pacing, visual continuity, and audio-visual sync." }
            ]
          },
          {
